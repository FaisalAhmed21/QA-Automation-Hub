          "name": "Register - Valid",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const unique = Date.now();",
                  "pm.collectionVariables.set('testUsername', 'user_' + unique);",
                  "pm.collectionVariables.set('testEmail', 'user_' + unique + '@example.com');",
                  "pm.collectionVariables.set('testPassword', 'SecurePass123!');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is correct', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has required fields', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('username');",
                  "    pm.expect(json).to.have.property('email');",
                  "});",
                  "",
                  "pm.test('Response time under 500ms', () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "const schema = {",
                  "    type: 'object',",
                  "    required: ['id', 'username', 'email'],",
                  "    properties: {",
                  "        id: { type: 'number' },",
                  "        username: { type: 'string' },",
                  "        email: { type: 'string' }",
                  "    }",
                  "};",
                  "",
                  "pm.test('Schema is valid', () => {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
